  Color _templateColor(int index) {
    const colors = [
      Color(0xFF6A1B9A),
      Color(0xFF1565C0),
      Color(0xFFC62828),
      Color(0xFF00695C),
    ];

    return colors[index % colors.length];
  }

  void _openEditor(String name) {
    Navigator.push(
      context,
      MaterialPageRoute(
        builder: (context) => StarCutEditor(projectName: name),
      ),
    );
  }

  void _showMessage(String message) {
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text(message),
        behavior: SnackBarBehavior.floating,
      ),
    );
  }
